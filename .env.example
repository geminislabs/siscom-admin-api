# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=siscom_admin

# AWS Credentials (opcional si usas IAM Role en EC2)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# AWS Cognito Configuration
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=your_user_pool_id_here
COGNITO_CLIENT_ID=your_client_id_here
COGNITO_CLIENT_SECRET=your_client_secret_here
DEFAULT_USER_PASSWORD=TempPass123!

# AWS SES - Email Configuration
SES_FROM_EMAIL=noreply@yourdomain.com
SES_REGION=us-east-1

# Frontend URL - Para construir URLs en los emails
FRONTEND_URL=http://localhost:3000

# PASETO - Clave base64 (32 bytes) para tokens de SERVICIO interno.
# NO compartir con siscom-api: firma credenciales `internal-*`.
# Generar con: openssl rand -base64 32
PASETO_SECRET_KEY=CAMBIAR_openssl_rand_base64_32

# Clave base64 (32 bytes) dedicada a los tokens de compartir ubicación.
# Es la única que se entrega a siscom-api. Debe ser DISTINTA de
# PASETO_SECRET_KEY. Si falta, /units/{id}/share-location devuelve 503.
# Generar con: openssl rand -base64 32
SHARE_LOCATION_KEY_B64=CAMBIAR_openssl_rand_base64_32

# Data token del plano de datos (Fase 1) — PASETO v4.public (Ed25519).
# admin-api FIRMA con la privada; siscom-api solo VERIFICA con la pública.
# Generar el par con:
#   python -c "from app.utils.data_token import generate_ed25519_keypair_b64 as g; \
#              priv, pub = g(); print(priv); print(pub)"
DATA_TOKEN_PRIVATE_KEY_B64=
DATA_TOKEN_KEY_ID=v1
# Secreto del índice de revocación (openssl rand -base64 32).
# Sin él no se puede revocar, y sin revocación no se emite.
DATA_TOKEN_INDEX_SECRET_B64=
# Valkey donde se materializa el alcance. Debe estar en la red compartida
# con siscom-api, que solo necesita lectura sobre dt:scope:*
VALKEY_URL=redis://localhost:6379/0

# Migración de compartir ubicación a v4.public. Poner a true SOLO cuando
# siscom-api ya sepa verificar el formato nuevo: el cambio de formato tiene que
# ir después, nunca antes. Con false se sigue usando SHARE_LOCATION_KEY_B64.
SHARE_LOCATION_USE_DATA_TOKEN=false
# Vida de un enlace compartido, en segundos (por defecto 1800 = 30 min).
SHARE_TOKEN_TTL_SECONDS=1800

# Contact Email - Email donde se reciben los mensajes de contacto
CONTACT_EMAIL=contacto@geminislabs.com

# Google reCAPTCHA v3 - Secret key para validación de formularios
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key-here

# TODO, remover esto, debe ir en commands processor que aun no hago.. es decir, siscom-admin-api no debe enviar los comandos
KORE_CLIENT_ID=apiclient_01

KORE_CLIENT_SECRET=kore_secret_01

KORE_API=https://supersim.api.korewireless.com/v1/

KORE_API_AUTH=https://kore.api.example

KORE_API_SMS=https://kore.api.example/smscommands


# Kafka - Alert rules updates
KAFKA_BROKERS=localhost:9092
KAFKA_RULES_UPDATES_TOPIC=alert-rules-updates
KAFKA_GEOFENCES_UPDATES_TOPIC=geofences-updates
KAFKA_USER_DEVICES_UPDATES_TOPIC=user-devices-updates
KAFKA_UNIT_DEVICES_UPDATES_TOPIC=unit-devices-updates
KAFKA_USER_UNITS_UPDATES_TOPIC=user-units-updates
KAFKA_RULES_UPDATES_GROUP_ID=alert-rules-updates-group
KAFKA_MOBILITY_TOPIC=mobility-locations-raw
KAFKA_TEAM_RULES_TOPIC=team-rules-updates
KAFKA_SASL_USERNAME=events-alert-consumer
KAFKA_SASL_PASSWORD=eventsalertconsumerpassword
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT

AWS_REGION=us-east-1
SNS_PLATFORM_APPLICATION_ARN_IOS=arn:aws:sns:example
SNS_PLATFORM_APPLICATION_ARN_ANDROID=arn:aws:sns:example

#Stripe

STRIPE_SECRET_KEY=stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=stripe_webhook_secret_here
STRIPE_PUBLISHABLE_KEY=stripe_publishable_key_here

# Facturapi — CFDI 4.0 (sk_test_… en local; nunca en el frontend)
FACTURAPI_API_KEY=
FACTURAPI_PRODUCT_KEY=81112100
FACTURAPI_UNIT_KEY=E48

# UUID de usuario Siscom para registered_by en pagos manuales (GAC)
GAC_SYSTEM_USER_ID=

#API config
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5160,http://10.8.0.1:5160,https://geminislabs.com,https://www.geminislabs.com,https://admin.geminislabs.com,https://nexus.geminislabs.com

# Observabilidad — Collector OTLP/HTTP externo (otro proyecto).
# Vacío = telemetría silenciosa; la API opera igual que sin OTel.
# En test/production setear la URL del Collector del entorno (nunca hardcodear).
OTLP_ENDPOINT=
# En local, "local". El deploy escribe "production" en el .env que genera.
DEPLOY_ENV=local
SERVICE_NAME=siscom-admin-api
# Hoy nada la inyecta: se queda en "unknown" hasta que el release la escriba.
SERVICE_VERSION=unknown
